# Orin Console — environment template. NEVER commit real values.

# Neon Postgres (pooled). Run schema.sql once. SAME database as Orin core
# is fine (separate console_* tables); or use a dedicated project.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Orin session signing key (HS256, min 32 chars). MUST match the Orin core
# TOKEN_ENCRYPTION_KEY — console verifies the same session tokens.
# MCP credential registry (mcp_credentials) is read from the same DB.
TOKEN_ENCRYPTION_KEY=

# Vercel Sandbox: no keys needed — OIDC is automatic on Vercel deployments.
# Local dev: `vercel link` + `vercel env pull` in this repo.

# --- Keyless access controls ------------------------------------------------
# Orin Console is usable without an account. These bound the cost of that.

# Live sessions allowed across all clients, enforced in the database.
# This is the real ceiling: it holds across serverless instances.
ORIN_CONSOLE_MAX_ACTIVE_SESSIONS=50

# Sessions a single IP may start per hour. Per-instance only, so it smooths
# bursts; it is not a global limit. The cap above is.
ORIN_CONSOLE_ANON_PER_HOUR=5
